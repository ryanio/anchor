#
# Anchor's local data service, as a systemd *user* unit.
#
# This exists so that "start the data service" is a thing the desktop does, not a command a human
# copies out of a bar widget. The widget's setup step runs
#
#     systemctl --user start anchor-service.service
#     systemctl --user enable --now anchor-service.service
#
# by fixed name — see `ACTIONS` in widget/PulseModel.js. A user unit, never a system one: the
# service reads one person's keyring and one person's config, so it has no business running before
# anybody has logged in, and `systemctl --user` needs no polkit prompt and grants no privilege the
# user did not already have.
#
# Install:
#   packaged    /usr/lib/systemd/user/anchor-service.service   (see PKGBUILD)
#   from source ~/.config/systemd/user/anchor-service.service  (see service/README.md)
#
[Unit]
Description=Anchor's local read-only OpenSea data service
Documentation=https://github.com/ryanio/anchor/blob/main/service/README.md
# Only useful while a desktop is up — the widget is its only consumer — and it should go away with
# the session rather than outlive it on a shared machine.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/anchor-service
# The upstream API is not ours and goes down; a service that gives up on the first 500 leaves the
# bar showing a stale number forever. `on-failure` and not `always`, so an intentional
# `systemctl --user stop` stays stopped and the widget's setup step can honestly say so.
Restart=on-failure
RestartSec=5

# Hardening. Deliberately partial, and the omissions are the interesting part:
#
#   ProtectHome  is absent because the service reads ~/.config/anchor/config.json and writes its
#                SQLite cache under $XDG_DATA_HOME.
#   ProtectSystem=strict is absent for the same reason — `strict` mounts $HOME read-only too, and
#                pinning it back with ReadWritePaths would break anyone whose XDG dirs are moved.
#                `full` covers /usr, /boot and /etc, which is what this process has no business in.
#   IPAddress*   is absent because the service really does make outbound calls to api.opensea.io.
#                Its *listening* socket is loopback-only, and that is enforced in the code
#                (service/src/server.ts, HOST) where it can be tested, not here.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target

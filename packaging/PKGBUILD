# Maintainer: Ryan Ghods <ryanio@users.noreply.github.com>
#
# Skeleton only — Anchor is not yet packaged. Target: the [omarchy] pacman
# repository (https://pkgs.omarchy.org), so installation becomes:
#     omarchy pkg install anchor

pkgname=anchor
pkgver=0.0.1
pkgrel=1
pkgdesc="Ambient OpenSea experience for Omarchy — a wallet-aware desktop"
arch=('x86_64')
url="https://github.com/ryanio/anchor"
license=('MIT')
# Version comes from .node-version at the repo root; scripts/check-versions.ts enforces it.
depends=('nodejs>=26')
makedepends=('git')
source=("git+https://github.com/ryanio/anchor.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  # TODO: install service/, widget/, theme/ once they exist.
  #
  # The service is no longer dependency-free: it needs @opensea/sdk and @opensea/api-types at
  # runtime (and their transitive deps — ethers, seaport-js, @noble/hashes). Packaging therefore
  # needs `npm ci --omit=dev --prefix service` at build time and the resulting node_modules
  # installed alongside the source, or those packages vendored. The executor still has none.
}
